{
  "schemaVersion": 1,
  "exerciseId": "vjezba-10-navalno-vozilo-hidrant",
  "synthetic": false,
  "clips": [
    {
      "id": "act.zbor",
      "voice": "zapovijed",
      "text": "Odjeljenje – zbor!",
      "hash": "0f463788e4c968"
    },
    {
      "id": "zbor",
      "voice": "opis",
      "text": "Oprema je smještena u spremnicima navalnog vozila. Kada je vozilo postavljeno na svoje mjesto, zapovjednik stane dva koraka iza vozila, podiže lijevu ruku i zapovijeda kao u vježbi 6.",
      "hash": "08b069bd135915"
    },
    {
      "id": "act.za-navalu",
      "voice": "zapovijed",
      "text": "Požar pravac … voda – hidrant, s dvije „B” cijevi do razdjelnice, za navalu – pripremi!",
      "hash": "011d2ef8d0d185"
    },
    {
      "id": "vodna-oprema",
      "voice": "opis",
      "text": "Po izdanoj zapovijedi zapovjednika: „Za navalu pripremi”, vodna grupa, navalna grupa i zapovjednik postupaju kao u vježbi 1 (skica 59).",
      "hash": "1a94e0261a05e4"
    },
    {
      "id": "act.vodu-daj-b",
      "voice": "zapovijed",
      "text": "Vodu daj!",
      "hash": "1a78cdd37ac23a"
    },
    {
      "id": "voda-do-razdjelnice",
      "voice": "opis",
      "text": "Strojar, kada je od člana navalne grupe (N2), koji je spojio „B” cijevni vod s razdjelnicom, primio zapovijed: „Vodu daj”, pušta vodu do razdjelnice i odlazi na polaganje cijevnog voda od hidranta do vozila kao u vježbi 8 (skica 60).",
      "hash": "1229c116068b71"
    },
    {
      "id": "act.prvi-mlaz-naprijed",
      "voice": "zapovijed",
      "text": "Za prvi mlaz s dvije „C” cijevi pravac …… naprijed!",
      "hash": "02c4d31ade157e"
    },
    {
      "id": "prvi-mlaz",
      "voice": "opis",
      "text": "Prvi mlaz polaže navalna grupa kao u vježbi 1.",
      "hash": "0c59761fc428d6"
    },
    {
      "id": "act.prvi-mlaz-vodu-daj",
      "voice": "zapovijed",
      "text": "Za prvi mlaz – vodu daj!",
      "hash": "04ff2bdaf377aa"
    },
    {
      "id": "act.drugi-mlaz-naprijed",
      "voice": "zapovijed",
      "text": "Za drugi mlaz s dvije „C” cijevi pravac …. naprijed!",
      "hash": "1d3ed303750025"
    },
    {
      "id": "drugi-mlaz-zapovijed",
      "voice": "opis",
      "text": "Drugi mlaz polaže vodna grupa kao u vježbi 1 (skica 61).",
      "hash": "14e67e0c16c583"
    },
    {
      "id": "act.drugi-mlaz-vodu-daj",
      "voice": "zapovijed",
      "text": "Za drugi mlaz vodu daj!",
      "hash": "1cf04cf004ca5b"
    },
    {
      "id": "act.vodom-stoj-mlazovi",
      "voice": "zapovijed",
      "text": "Prvi i drugi mlaz – vodom stoj!",
      "hash": "0755cc211bdcd8"
    },
    {
      "id": "vodom-stoj",
      "voice": "opis",
      "text": "Zapovjednik obavlja pospremu kao u vježbi 9.",
      "hash": "0928e9ddcc88f1"
    },
    {
      "id": "act.vodom-stoj-prvi",
      "voice": "zapovijed",
      "text": "Prvi mlaz – vodom stoj!",
      "hash": "05455f7ba0ee95"
    },
    {
      "id": "act.vodom-stoj-drugi",
      "voice": "zapovijed",
      "text": "Drugi mlaz – vodom stoj!",
      "hash": "1d5ead4a01215b"
    },
    {
      "id": "act.z-vodom-stoj",
      "voice": "zapovijed",
      "text": "Vodom stoj!",
      "hash": "138cf361a363ce"
    },
    {
      "id": "act.posprema",
      "voice": "zapovijed",
      "text": "Posprema!",
      "hash": "13469a9e41281c"
    },
    {
      "id": "posprema-strojar",
      "voice": "opis",
      "text": "Navalna i vodna grupa obavljaju pospremu navalnog sektora kao u vježbi 9, dok cijevni sektor posprema vodna grupa, kao što to posprema navalna grupa u vježbi 9. Strojar, na zapovijed „Posprema!”, postupa kao u vježbi 8.",
      "hash": "0a6fcb22c45eb0"
    },
    {
      "id": "act.opremu-uzmi",
      "voice": "zapovijed",
      "text": "Opremu uzmi!",
      "hash": "03cf2ae0d2e3ab"
    },
    {
      "id": "act.s-opremom-naprijed",
      "voice": "zapovijed",
      "text": "S opremom naprijed!",
      "hash": "123f97f88a0ac1"
    },
    {
      "id": "act.stoj",
      "voice": "zapovijed",
      "text": "Stoj!",
      "hash": "0c041f0f1e56a9"
    },
    {
      "id": "act.opremu-odlozi",
      "voice": "zapovijed",
      "text": "Opremu odloži!",
      "hash": "1401b177c2cb0a"
    },
    {
      "id": "navalna-u-stroj",
      "voice": "opis",
      "text": "Kada odlože opremu, vatrogasci odlaze u stroj i postupaju kao u vježbi 1.",
      "hash": "0217d21ec51a1e"
    },
    {
      "id": "act.prijavak",
      "voice": "zapovijed",
      "text": "Gospodine zapovjedniče, vježba je izvršena, oprema je na svome mjestu!",
      "hash": "00e19441164dc7"
    },
    {
      "id": "act.na-svoje-mjesto",
      "voice": "zapovijed",
      "text": "Na svoje mjesto!",
      "hash": "163ba54158fbfe"
    },
    {
      "id": "act.na-zapovijed",
      "voice": "zapovijed",
      "text": "Na zapovijed!",
      "hash": "182ecc34d3ef04"
    },
    {
      "id": "act.odmor-ili-otpust",
      "voice": "zapovijed",
      "text": "Na mjestu odmor!",
      "hash": "06d370de725f05"
    }
  ],
