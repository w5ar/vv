{
  "schemaVersion": 1,
  "exerciseId": "vjezba-12-b-mlaz",
  "synthetic": false,
  "clips": [
    {
      "id": "act.zbor",
      "voice": "zapovijed",
      "text": "Odjeljenje – zbor!",
      "hash": "0f463788e4c968"
    },
    {
      "id": "zbor",
      "voice": "opis",
      "text": "Kada je vozilo postavljeno na svoje mjesto, zapovjednik postrojava odjeljenje kao u vježbi 9.",
      "hash": "06bdd6ce19e97d"
    },
    {
      "id": "act.za-navalu",
      "voice": "zapovijed",
      "text": "Požar pravac…voda – hidrant, s dvije „B” cijevi do razdjelnice, za „B” mlaz, za navalu pripremi!",
      "hash": "0df93e2b6a26ae"
    },
    {
      "id": "zapovijed-za-navalu",
      "voice": "opis",
      "text": "Zapovjednik istupa ispred odjeljenja kao u vježbi 1 i zapovijeda:",
      "hash": "11e43011d7f17b"
    },
    {
      "id": "vodna-oprema",
      "voice": "opis",
      "text": "Vodna grupa polaže „B” cijevni vod kao u vježbi 1 (skica 65).",
      "hash": "0cd5a61a99dcbc"
    },
    {
      "id": "navalna-oprema-n1",
      "voice": "opis",
      "text": "Navalna grupa se oprema za polaganje prvog „B” mlaza i uzima sljedeću opremu: vođa grupe (N1) uzima držač cijevi, „B” mlaznicu s ublaživačem reakcije mlaza i stavlja je za opasač, u desnu ruku uzima razdjelnicu, a u lijevu ruku jednu „B” cijev, a član grupe (N2) u svaku ruku po jednu „B” cijev. Tako opremljeni kreću se lijevom stranom „B” cijevnog voda i postupaju kao u vježbi 1. Zapovijed za prvi mlaz glasi: „Za prvi „B” mlaz, s dvije „B” cijevi pravac…naprijed”. Prvi „B” mlaz polaže se na srednji otvor razdjelnice. Postupci spajanja i polaganja cijevi prvog mlaza isti su kao u vježbi 1, s razlikom što član grupe (N2) drugu „B” cijev izbacuje u lijevu i desnu stranu, tako da cijev dobije manji luk i pravi oblik slova „S”.",
      "hash": "19509a9549cec7"
    },
    {
      "id": "act.vodu-daj-b",
      "voice": "zapovijed",
      "text": "Vodu daj!",
      "hash": "1a78cdd37ac23a"
    },
    {
      "id": "voda-do-razdjelnice",
      "voice": "opis",
      "text": "Strojar polaže cijevni vod od hidranta do vozila kao u vježbi 10 (skica 66).",
      "hash": "13d46f4302e212"
    },
    {
      "id": "act.prvi-mlaz-naprijed",
      "voice": "zapovijed",
      "text": "Za prvi „B” mlaz, s dvije „B” cijevi pravac…naprijed",
      "hash": "09a01da7a7aad2"
    },
    {
      "id": "act.prvi-mlaz-vodu-daj",
      "voice": "zapovijed",
      "text": "Za prvi mlaz – vodu daj!",
      "hash": "04ff2bdaf377aa"
    },
    {
      "id": "act.drugi-mlaz-naprijed",
      "voice": "zapovijed",
      "text": "Za drugi mlaz s dvije „C” cijevi pravac …. naprijed!",
      "hash": "1d3ed303750025"
    },
    {
      "id": "drugi-mlaz-zapovijed",
      "voice": "opis",
      "text": "Drugi mlaz polaže vodna grupa kao u vježbi 1 (skica 67).",
      "hash": "0cccdd39626cc9"
    },
    {
      "id": "act.drugi-mlaz-vodu-daj",
      "voice": "zapovijed",
      "text": "Za drugi mlaz vodu daj!",
      "hash": "1cf04cf004ca5b"
    },
    {
      "id": "act.vodom-stoj-mlazovi",
      "voice": "zapovijed",
      "text": "Prvi „B” mlaz i drugi mlaz – vodom stoj",
      "hash": "13fa51584ed74a"
    },
    {
      "id": "vodom-stoj",
      "voice": "opis",
      "text": "Zapovjednik zapovijeda:",
      "hash": "10387e6d3d4fad"
    },
    {
      "id": "vodom-stoj-2",
      "voice": "opis",
      "text": "Ostale zapovijedi i radnje zapovjednika iste su kao u vježbi 1.",
      "hash": "1157f1af341f92"
    },
    {
      "id": "act.vodom-stoj-prvi",
      "voice": "zapovijed",
      "text": "Prvi „B” mlaz – vodom stoj!",
      "hash": "183f56f9ea2fb0"
    },
    {
      "id": "vodom-stoj-vode",
      "voice": "opis",
      "text": "Na tu zapovijed zapovjednika, N1 izdaje zapovijed:",
      "hash": "053b08228e608d"
    },
    {
      "id": "act.vodom-stoj-drugi",
      "voice": "zapovijed",
      "text": "Drugi mlaz – vodom stoj!",
      "hash": "1d5ead4a01215b"
    },
    {
      "id": "vodom-stoj-vode-2",
      "voice": "opis",
      "text": "a preostale zapovijedi i radnje za pospremu prvog i drugog cijevnog voda u navalnom sektoru i posprema „B” cijevnog voda iste su kao u vježbi 10.",
      "hash": "0d17d8351d4c01"
    },
    {
      "id": "act.z-vodom-stoj",
      "voice": "zapovijed",
      "text": "Vodom stoj!",
      "hash": "138cf361a363ce"
    },
    {
      "id": "act.posprema",
      "voice": "zapovijed",
      "text": "Posprema!",
      "hash": "13469a9e41281c"
    },
    {
      "id": "posprema-strojar",
      "voice": "opis",
      "text": "Strojar na zapovijed: „Posprema” postupa kao u vježbi 8.",
      "hash": "174526bac24eee"
    },
    {
      "id": "act.opremu-uzmi",
      "voice": "zapovijed",
      "text": "Opremu uzmi!",
      "hash": "03cf2ae0d2e3ab"
    },
    {
      "id": "act.s-opremom-naprijed",
      "voice": "zapovijed",
      "text": "S opremom naprijed!",
      "hash": "123f97f88a0ac1"
    },
    {
      "id": "act.stoj",
      "voice": "zapovijed",
      "text": "Stoj!",
      "hash": "0c041f0f1e56a9"
    },
    {
      "id": "act.opremu-odlozi",
      "voice": "zapovijed",
      "text": "Opremu odloži!",
      "hash": "1401b177c2cb0a"
    },
    {
      "id": "navalna-u-stroj",
      "voice": "opis",
      "text": "Kad odlože opremu, vatrogasci odlaze u stroj i postupaju kao u vježbi 1.",
      "hash": "159eba1249b117"
    },
    {
      "id": "act.prijavak",
      "voice": "zapovijed",
      "text": "Gospodine zapovjedniče, vježba je izvršena, oprema je na svome mjestu!",
      "hash": "00e19441164dc7"
    },
    {
      "id": "act.na-svoje-mjesto",
      "voice": "zapovijed",
      "text": "Na svoje mjesto!",
      "hash": "163ba54158fbfe"
    },
    {
      "id": "act.na-zapovijed",
      "voice": "zapovijed",
      "text": "Na zapovijed!",
      "hash": "182ecc34d3ef04"
    },
    {
      "id": "act.odmor-ili-otpust",
      "voice": "zapovijed",
      "text": "Na mjestu odmor!",
      "hash": "06d370de725f05"
    }
  ],
