{
  "schemaVersion": 1,
  "exerciseId": "vjezba-9-navalno-vozilo",
  "synthetic": false,
  "clips": [
    {
      "id": "act.zbor",
      "voice": "zapovijed",
      "text": "Odjeljenje – zbor!",
      "hash": "0f463788e4c968"
    },
    {
      "id": "zbor",
      "voice": "opis",
      "text": "Za izvođenje vježbe potrebna je vatrogasna oprema smještena u spremnicima navalnog vozila. Kada je vozilo postavljeno na svoje mjesto, zapovjednik staje dva koraka iza vozila, podiže lijevu ruku i zapovijeda kao u vježbi 5 (skica 55, slika 40).",
      "hash": "0843a3e1f066aa"
    },
    {
      "id": "act.za-navalu",
      "voice": "zapovijed",
      "text": "Požar pravac…voda…sa dvije „B” cijevi do razdjelnice za navalu pripremi",
      "hash": "09e88337e8ae68"
    },
    {
      "id": "zapovijed-za-navalu",
      "voice": "opis",
      "text": "Nakon izdane zapovijedi zapovjednika:",
      "hash": "03189d4b333b91"
    },
    {
      "id": "zapovijed-za-navalu-2",
      "voice": "opis",
      "text": "strojar zapovijeda: „Četiri usisne cijevi”. Kod te vježbe, spajanje usisnog voda, vezanje usisnog voda i nepovratnog ventila usisne sitke i prenošenje usisnog voda do crpilišta, obavlja vodna grupa i strojar kao što je to obavljala navalna grupa sa strojarem u vježbi 7. Na zapovijed strojara „Gotovo”, član grupe (V2) uzima torbicu s povezicama i zajedno s vođom grupe (V1) ostaje kod vozila do zapovijedi zapovjednika za drugi mlaz.",
      "hash": "1d9f0c3b29cfa6"
    },
    {
      "id": "act.cetiri-usisne",
      "voice": "zapovijed",
      "text": "Četiri usisne cijevi",
      "hash": "062ccfd6792aeb"
    },
    {
      "id": "act.dizi-1",
      "voice": "zapovijed",
      "text": "Diži!",
      "hash": "1f917b3323a5e2"
    },
    {
      "id": "act.spusti-1",
      "voice": "zapovijed",
      "text": "Spusti!",
      "hash": "1a1db46ccfb9c3"
    },
    {
      "id": "act.dizi-2",
      "voice": "zapovijed",
      "text": "Diži!",
      "hash": "1f917b3323a5e2"
    },
    {
      "id": "act.spusti-2",
      "voice": "zapovijed",
      "text": "Spusti!",
      "hash": "1a1db46ccfb9c3"
    },
    {
      "id": "act.dizi-3",
      "voice": "zapovijed",
      "text": "Diži!",
      "hash": "1f917b3323a5e2"
    },
    {
      "id": "act.spusti-3",
      "voice": "zapovijed",
      "text": "Spusti!",
      "hash": "1a1db46ccfb9c3"
    },
    {
      "id": "act.dizi-4",
      "voice": "zapovijed",
      "text": "Diži!",
      "hash": "1f917b3323a5e2"
    },
    {
      "id": "act.spusti-4",
      "voice": "zapovijed",
      "text": "Spusti!",
      "hash": "1a1db46ccfb9c3"
    },
    {
      "id": "act.uzetom-vezi",
      "voice": "zapovijed",
      "text": "Užetom veži!",
      "hash": "10069c60053e07"
    },
    {
      "id": "act.u-vodu",
      "voice": "zapovijed",
      "text": "Usisni vod u vodu!",
      "hash": "1255f9b780d4e8"
    },
    {
      "id": "act.gotovo",
      "voice": "zapovijed",
      "text": "Gotovo!",
      "hash": "0bb3d9f76c7717"
    },
    {
      "id": "navalna-b-oprema",
      "voice": "opis",
      "text": "Navalna grupa polaže „B” cijevni vod kao u vježbi 5 (skica 56, slika 41).",
      "hash": "1a95b9b848cef3"
    },
    {
      "id": "act.vodu-daj-b",
      "voice": "zapovijed",
      "text": "Vodu daj!",
      "hash": "1a78cdd37ac23a"
    },
    {
      "id": "act.prvi-mlaz-naprijed",
      "voice": "zapovijed",
      "text": "Za prvi mlaz s dvije „C” cijevi pravac … naprijed!",
      "hash": "02bfb140f55827"
    },
    {
      "id": "prvi-mlaz",
      "voice": "opis",
      "text": "Navalna grupa polaže prvi mlaz kao u vježbi 5.",
      "hash": "1e0f015908d694"
    },
    {
      "id": "zapovjednik-posluzuje",
      "voice": "opis",
      "text": "Zapovjednik postupa isto kao u vježbi 5 (skica 57).",
      "hash": "06749028956d02"
    },
    {
      "id": "act.prvi-mlaz-vodu-daj",
      "voice": "zapovijed",
      "text": "Za prvi mlaz – vodu daj!",
      "hash": "04ff2bdaf377aa"
    },
    {
      "id": "act.drugi-mlaz-naprijed",
      "voice": "zapovijed",
      "text": "Za drugi mlaz s dvije „C” cijevi pravac … naprijed!",
      "hash": "105ba74a19bb1b"
    },
    {
      "id": "drugi-mlaz-zapovijed",
      "voice": "opis",
      "text": "Vodna grupa polaže drugi mlaz kao u vježbi 5 (skica 58).",
      "hash": "01fc3d0bda9908"
    },
    {
      "id": "act.drugi-mlaz-vodu-daj",
      "voice": "zapovijed",
      "text": "Za drugi mlaz vodu daj!",
      "hash": "1cf04cf004ca5b"
    },
    {
      "id": "act.vodom-stoj-mlazovi",
      "voice": "zapovijed",
      "text": "Prvi i drugi mlaz – vodom stoj!",
      "hash": "0755cc211bdcd8"
    },
    {
      "id": "vodom-stoj",
      "voice": "opis",
      "text": "Zapovijedi i radnje zapovjednika iste su kao u vježbi 5, samo što torbicu s povezicama i ključeve zapovjednik odlaže u vozilo na mjesta gdje su stajali prije izvođenja vježbe. Posprema prvog i drugog cijevnog voda i posprema „B” cijevnog voda ista je kao u vježbi 5, sa sljedećom razlikom: kada navalna i vodna grupa s opremom prvog i drugog „C” mlaza dođu ispred vozila, postupaju kao navalna grupa u vježbi 7. Usisni vod posprema vodna grupa i strojar, kao što je to pospremala navalna grupa sa strojarem u vježbi 7.",
      "hash": "196fc90f8e5376"
    },
    {
      "id": "act.vodom-stoj-prvi",
      "voice": "zapovijed",
      "text": "Prvi mlaz – vodom stoj!",
      "hash": "05455f7ba0ee95"
    },
    {
      "id": "act.vodom-stoj-drugi",
      "voice": "zapovijed",
      "text": "Drugi mlaz – vodom stoj!",
      "hash": "1d5ead4a01215b"
    },
    {
      "id": "act.z-vodom-stoj",
      "voice": "zapovijed",
      "text": "Vodom stoj!",
      "hash": "138cf361a363ce"
    },
    {
      "id": "act.posprema",
      "voice": "zapovijed",
      "text": "Posprema!",
      "hash": "13469a9e41281c"
    },
    {
      "id": "act.opremu-uzmi",
      "voice": "zapovijed",
      "text": "Opremu uzmi!",
      "hash": "03cf2ae0d2e3ab"
    },
    {
      "id": "act.s-opremom-naprijed",
      "voice": "zapovijed",
      "text": "S opremom naprijed!",
      "hash": "123f97f88a0ac1"
    },
    {
      "id": "act.stoj",
      "voice": "zapovijed",
      "text": "Stoj!",
      "hash": "0c041f0f1e56a9"
    },
    {
      "id": "act.opremu-odlozi",
      "voice": "zapovijed",
      "text": "Opremu odloži!",
      "hash": "1401b177c2cb0a"
    },
    {
      "id": "act.iz-vode",
      "voice": "zapovijed",
      "text": "Usisni vod iz vode!",
      "hash": "11a10d57c3b649"
    },
    {
      "id": "act.dizi-spusti-r1",
      "voice": "zapovijed",
      "text": "Diži – spusti!",
      "hash": "1254e5ec47db2d"
    },
    {
      "id": "act.dizi-spusti-r2",
      "voice": "zapovijed",
      "text": "Diži – spusti!",
      "hash": "1254e5ec47db2d"
    },
    {
      "id": "act.dizi-spusti-r3",
      "voice": "zapovijed",
      "text": "Diži – spusti!",
      "hash": "1254e5ec47db2d"
    },
    {
      "id": "act.dizi-spusti-r4",
      "voice": "zapovijed",
      "text": "Diži – spusti!",
      "hash": "1254e5ec47db2d"
    },
    {
      "id": "pregled-opreme",
      "voice": "opis",
      "text": "Kad odlože opremu, vatrogasci odlaze u stroj i postupaju kao u vježbi 1.",
      "hash": "159eba1249b117"
    },
    {
      "id": "act.prijavak",
      "voice": "zapovijed",
      "text": "Gospodine zapovjedniče, vježba je izvršena, oprema je na svome mjestu!",
      "hash": "00e19441164dc7"
    },
    {
      "id": "act.na-svoje-mjesto",
      "voice": "zapovijed",
      "text": "Na svoje mjesto!",
      "hash": "163ba54158fbfe"
    },
    {
      "id": "act.na-zapovijed",
      "voice": "zapovijed",
      "text": "Na zapovijed!",
      "hash": "182ecc34d3ef04"
    },
    {
      "id": "act.odmor-ili-otpust",
      "voice": "zapovijed",
      "text": "Na mjestu odmor!",
      "hash": "06d370de725f05"
    }
  ],
