{
  "schemaVersion": 1,
  "exerciseId": "sinteticka-vjezba-01",
  "synthetic": true,
  "clips": [
    {
      "id": "korak-1",
      "voice": "opis",
      "text": "Voditelj daje znak za početak vježbe.",
      "hash": "0f14e5293c0d7d"
    },
    {
      "id": "korak-2",
      "voice": "opis",
      "text": "Član 1 uzima razdjelnik i postavlja ga na označeno mjesto razdjelnika.",
      "hash": "1598ca09f2b63a"
    },
    {
      "id": "korak-3",
      "voice": "opis",
      "text": "Član 2 uzima cijev s velikim spojem, polaže je i spaja na prvi izlaz vozila.",
      "hash": "08acb6da02a80d"
    },
    {
      "id": "korak-4",
      "voice": "opis",
      "text": "Član 2 spaja slobodni kraj velike cijevi na ulaz razdjelnika.",
      "hash": "0551231c320c52"
    },
    {
      "id": "korak-5",
      "voice": "opis",
      "text": "Član 1 uzima cijev s malim spojem i mlaznicu, spaja cijev na razdjelnik i postavlja mlaznicu u ciljno područje.",
      "hash": "03af2425813653"
    },
    {
      "id": "korak-6",
      "voice": "opis",
      "text": "Član 2 uzima drugu cijev s malim spojem i mlaznicu, spaja cijev na razdjelnik i postavlja mlaznicu u ciljno područje.",
      "hash": "066375ed2bc539"
    },
    {
      "id": "korak-7",
      "voice": "opis",
      "text": "Član 1 ili Član 2 javlja spremnost voditelju.",
      "hash": "108de7432f89eb"
    },
    {
      "id": "korak-8",
      "voice": "opis",
      "text": "Voditelj daje znak za otvaranje, a članovi otvaraju mlaznice.",
      "hash": "1668a7d017e3b8"
    }
  ],
