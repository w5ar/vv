{
  "schemaVersion": 1,
  "exerciseId": "vjezba-14-pjena-izolacijski-aparati",
  "synthetic": false,
  "clips": [
    {
      "id": "act.zbor",
      "voice": "zapovijed",
      "text": "Odjeljenje – zbor!",
      "hash": "0f463788e4c968"
    },
    {
      "id": "zbor",
      "voice": "opis",
      "text": "Oprema je smještena u spremnicima navalnog vozila. Kada je vozilo postavljeno na svoje mjesto, zapovjednik postrojava odjeljenje kao u vježbi 9.",
      "hash": "1fbe695566586a"
    },
    {
      "id": "istupanje",
      "voice": "opis",
      "text": "Zapovjednik istupa ispred odjeljenja kao u vježbi 1 i zapovijeda:",
      "hash": "11e43011d7f17b"
    },
    {
      "id": "act.za-navalu",
      "voice": "zapovijed",
      "text": "Požar pravac...voda – hidrant, sa dvije „B” cijevi do razdjelnice, prvi mlaz pjenom, navalna grupa se oprema izolacijskim aparatima – za navalu pripremi!",
      "hash": "064a4c61e8903b"
    },
    {
      "id": "vodna-oprema",
      "voice": "opis",
      "text": "Vodna grupa polaže „B” cijevni vod kao u vježbi 1. Kada su položili „B” cijevni vod vraćaju se do vozila i opremaju za polaganje prvog mlaza pjene. Uzimaju istu opremu kao navalna grupa u vježbi 13.",
      "hash": "1de1471eb4d70d"
    },
    {
      "id": "opremanje-ia",
      "voice": "opis",
      "text": "Na zapovijed zapovjednika: „Za navalu – pripremi”, navalna grupa se uz pomoć zapovjednika oprema izolacijskim aparatima. Nakon opremanja, navalna grupa postupa kao u vježbi 11, a zapovjednik uzima međumješalicu sa usisnom cijevi za pjenilo u lijevu ruku, a posudu s pjenilom u desnu, kreće se desnom stranom „B” cijevnog voda do razdjelnice gdje staje s njezine desne strane i odlaže opremu pored sebe na zemlju (skica 71, slika 46).",
      "hash": "0e2c10ff7bcbbe"
    },
    {
      "id": "act.vodu-daj-b",
      "voice": "zapovijed",
      "text": "Vodu daj!",
      "hash": "1a78cdd37ac23a"
    },
    {
      "id": "voda-do-razdjelnice",
      "voice": "opis",
      "text": "Strojar polaže cijevni vod od hidranta do vozila kao u vježbi 10 (skica 72, slika 47).",
      "hash": "1cde980986fc42"
    },
    {
      "id": "act.prvi-mlaz-naprijed",
      "voice": "zapovijed",
      "text": "Za prvi mlaz pjenom, sa dvije „C” cijevi, međumješalica poslije prve „C” cijevi, navalna grupa s izolacijskim aparatima, pravac...naprijed",
      "hash": "11cc252dd24768"
    },
    {
      "id": "prvi-mlaz-zapovijed",
      "voice": "opis",
      "text": "Nakon što je član vodne grupe (V2) dobio vodu do razdjelnice, zapovjednik zapovijeda:",
      "hash": "1bd8ad1bb06fd0"
    },
    {
      "id": "prvi-mlaz",
      "voice": "opis",
      "text": "Vodna grupa i zapovjednik polažu prvi mlaz na srednji otvor razdjelnice.",
      "hash": "0f59ffc15ef690"
    },
    {
      "id": "prvi-mlaz-mm",
      "voice": "opis",
      "text": "Prvi mlaz polažu kao navalna grupa (N1 i N2) s članom vodne grupe (V2) kao u vježbi 13, s razlikom što zapovjednik odlaže međumješalicu i posudu s pjenilom poslije prve „C” cijevi, vraća se lijevom stranom „C” cijevi i staje tri koraka desno od razdjelnice, okrenut prema razdjelnici.",
      "hash": "1515c241ee972c"
    },
    {
      "id": "prvi-mlaz-predaja",
      "voice": "opis",
      "text": "Navalna grupa se kreće lijevom stranom do završetka cijevnog voda za prvi mlaz, gdje vođa vodne grupe (V1) predaje mlaznicu i držač cijevi vođi navalne grupe (N1). Član vodne grupe (V2) odlazi na međumješalicu, a vođa (V1) na razdjelnicu, gdje ostaju do zapovijedi za drugi mlaz.",
      "hash": "1be7ef09094967"
    },
    {
      "id": "act.pjenu-daj",
      "voice": "zapovijed",
      "text": "Za prvi mlaz – pjenu daj!",
      "hash": "00cf40717b7715"
    },
    {
      "id": "act.drugi-mlaz-naprijed",
      "voice": "zapovijed",
      "text": "Za drugi mlaz s dvije „C” cijevi pravac …. naprijed!",
      "hash": "1d3ed303750025"
    },
    {
      "id": "drugi-mlaz-zapovijed",
      "voice": "opis",
      "text": "Vodna grupa polaže drugi mlaz kao u vježbi 13 (skica 73, slika 48).",
      "hash": "07ee44c75b1b1b"
    },
    {
      "id": "act.drugi-mlaz-vodu-daj",
      "voice": "zapovijed",
      "text": "Za drugi mlaz vodu daj!",
      "hash": "1cf04cf004ca5b"
    },
    {
      "id": "act.vodom-stoj-mlazovi",
      "voice": "zapovijed",
      "text": "Prvi mlaz pjenom i drugi mlaz – vodom stoj!",
      "hash": "01bb2992d77fc0"
    },
    {
      "id": "vodom-stoj",
      "voice": "opis",
      "text": "Zapovjednik zapovijeda:",
      "hash": "10387e6d3d4fad"
    },
    {
      "id": "vodom-stoj-2",
      "voice": "opis",
      "text": "Na zapovijed: „Prvi mlaz – pjenom stoj!” N1 obavlja radnje kao u vježbi 13.",
      "hash": "060592834d7757"
    },
    {
      "id": "act.pjenom-stoj",
      "voice": "zapovijed",
      "text": "Prvi mlaz – pjenom stoj!",
      "hash": "18e0e92732d535"
    },
    {
      "id": "act.vodom-stoj-drugi",
      "voice": "zapovijed",
      "text": "Drugi mlaz – vodom stoj!",
      "hash": "1d5ead4a01215b"
    },
    {
      "id": "drugi-stoj",
      "voice": "opis",
      "text": "Tek nakon zatvorenog prvog mlaza vođa vodne grupe (V1) izdaje zapovijed:",
      "hash": "0e01d6c4ee4b00"
    },
    {
      "id": "act.z-vodom-stoj",
      "voice": "zapovijed",
      "text": "Vodom stoj!",
      "hash": "138cf361a363ce"
    },
    {
      "id": "zatvaranje-drugog",
      "voice": "opis",
      "text": "„Drugi mlaz – vodom stoj!”. Nakon izdane zapovijedi zapovjednika „Posprema!”, zapovjednik rastavlja cijevi s razdjelnice kao u vježbi 1, rastavlja i uzima međumješalicu i posudu s pjenilom kao u vježbi 13. Kreće se lijevom stranom „B” cijevnog voda do spoja prve i druge „B” cijevi, spušta opremu na zemlju, rastavlja spojnice i uzima i odnosi opremu u vozilo. Kada je odložio opremu, pomaže navalnoj grupi u skidanju izolacijskih aparata.",
      "hash": "1424d687fc00fc"
    },
    {
      "id": "act.posprema",
      "voice": "zapovijed",
      "text": "Posprema!",
      "hash": "13469a9e41281c"
    },
    {
      "id": "posprema-strojar",
      "voice": "opis",
      "text": "Strojar na zapovijed: „Posprema!” postupa kao u vježbi 8.",
      "hash": "0bb64929f21771"
    },
    {
      "id": "navalna-u-stroj",
      "voice": "opis",
      "text": "Kad odlože opremu, vatrogasci odlaze u stroj i postupaju kao u vježbi 1.",
      "hash": "159eba1249b117"
    },
    {
      "id": "posprema-drugi",
      "voice": "opis",
      "text": "Vodna grupa postupa kao u vježbi 11.",
      "hash": "0b96c3aa118735"
    },
    {
      "id": "act.opremu-uzmi-drugi",
      "voice": "zapovijed",
      "text": "Opremu uzmi!",
      "hash": "03cf2ae0d2e3ab"
    },
    {
      "id": "act.s-opremom-naprijed-drugi",
      "voice": "zapovijed",
      "text": "S opremom naprijed!",
      "hash": "123f97f88a0ac1"
    },
    {
      "id": "act.stoj-drugi",
      "voice": "zapovijed",
      "text": "Stoj!",
      "hash": "0c041f0f1e56a9"
    },
    {
      "id": "act.opremu-odlozi-drugi",
      "voice": "zapovijed",
      "text": "Opremu odloži!",
      "hash": "1401b177c2cb0a"
    },
    {
      "id": "act.opremu-uzmi-prvi",
      "voice": "zapovijed",
      "text": "Opremu uzmi!",
      "hash": "03cf2ae0d2e3ab"
    },
    {
      "id": "act.s-opremom-naprijed-prvi",
      "voice": "zapovijed",
      "text": "S opremom naprijed!",
      "hash": "123f97f88a0ac1"
    },
    {
      "id": "act.stoj-prvi",
      "voice": "zapovijed",
      "text": "Stoj!",
      "hash": "0c041f0f1e56a9"
    },
    {
      "id": "act.opremu-odlozi-prvi",
      "voice": "zapovijed",
      "text": "Opremu odloži!",
      "hash": "1401b177c2cb0a"
    },
    {
      "id": "act.prijavak",
      "voice": "zapovijed",
      "text": "Gospodine zapovjedniče, vježba je izvršena, oprema je na svome mjestu!",
      "hash": "00e19441164dc7"
    },
    {
      "id": "act.na-svoje-mjesto",
      "voice": "zapovijed",
      "text": "Na svoje mjesto!",
      "hash": "163ba54158fbfe"
    },
    {
      "id": "act.na-zapovijed",
      "voice": "zapovijed",
      "text": "Na zapovijed!",
      "hash": "182ecc34d3ef04"
    },
    {
      "id": "act.odmor-ili-otpust",
      "voice": "zapovijed",
      "text": "Na mjestu odmor!",
      "hash": "06d370de725f05"
    }
  ],
