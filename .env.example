# Postavke za generiranje zvučnih zapisa demonstracija: python3 tools/generate_audio.py
# Kopirajte ovu datoteku u .env (ne predaje se u git) i upišite svoj OpenAI API ključ.

OPENAI_API_KEY=

# Neobavezno (prikazane su zadane vrijednosti):
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Ženski glas za opis koraka
# OPENAI_TTS_VOICE_OPIS=nova
# Strogi muški glas za zapovijedi i prijavke
# OPENAI_TTS_VOICE_ZAPOVIJED=onyx
# Upute o načinu govora (samo modeli gpt-4o-mini-tts i noviji; vidi tools/generate_audio.py)
# OPENAI_TTS_INSTRUCTIONS_OPIS=
# OPENAI_TTS_INSTRUCTIONS_ZAPOVIJED=
# OPENAI_BASE_URL=https://api.openai.com/v1
